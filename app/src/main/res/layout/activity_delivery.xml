<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Phase Banner -->
        <TextView
            android:id="@+id/tvPhaseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHASE 1: ARRIVED AT PICKUP"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/primary"
            android:padding="16dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/tvPhaseStatus">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPackageId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Package: P001"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvSenderInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sender: Name (Phone)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/successGreen"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pickup: Dhanmondi"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/textSecondary"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:id="@+id/tvReceiverInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receiver: Phone"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/warningOrange" />

                <TextView
                    android:id="@+id/tvDropAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drop: Gulshan"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight: 5kg"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardDetails">

            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="NAVIGATE"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="CALL"
                android:textColor="@color/white"
                android:backgroundTint="@color/successGreen"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Proof Photo -->
        <ImageView
            android:id="@+id/ivProofPhoto"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@color/textSecondary"
            app:layout_constraintTop_toBottomOf="@id/llActions" />

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="TAKE PROOF PHOTO"
            android:textColor="@color/textOnAccent"
            android:backgroundTint="@color/accent"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/ivProofPhoto" />

        <Button
            android:id="@+id/btnCompleteDelivery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="VERIFY PICKUP OTP"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnTakePhoto" />

        <!-- Unassign Button -->
        <Button
            android:id="@+id/btnUnassign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Unassign Package (20% Penalty)"
            android:textColor="@color/errorRed"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:layout_constraintTop_toBottomOf="@id/btnCompleteDelivery" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>