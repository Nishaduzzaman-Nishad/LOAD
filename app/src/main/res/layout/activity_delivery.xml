<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDeliveryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/tvDeliveryTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPackageId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Package: P001"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvOtpDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secret OTP: 1234"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/warningOrange"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pickup: Dhanmondi"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvDropAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drop: Gulshan"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight: 5kg"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- IN-APP MAP (osmdroid) -->
        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:background="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/cardDetails" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/map">

            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="External Nav"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Call Receiver"
                android:textColor="@color/white"
                android:backgroundTint="@color/successGreen"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivProofPhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@color/textSecondary"
            app:layout_constraintTop_toBottomOf="@id/llActions" />

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Take Proof Photo"
            android:textColor="@color/primary"
            android:backgroundTint="@color/accent"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/ivProofPhoto" />

        <Button
            android:id="@+id/btnCompleteDelivery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Complete Delivery (OTP)"
            android:textColor="@color/white"
            android:backgroundTint="@color/successGreen"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnTakePhoto" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>