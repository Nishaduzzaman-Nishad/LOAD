    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Admin Alerts" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary" android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAdminNotifications" android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>